# HIL Bench Controller — udev rules
# Provides stable device names and permissions for bench hardware.

# Atmel-ICE JTAG/SWD programmer (Microchip/Atmel VID:PID 03eb:2141)
SUBSYSTEM=="usb", ATTR{idVendor}=="03eb", ATTR{idProduct}=="2141", \
    MODE="0666", \
    SYMLINK+="atmel-ice-%n", \
    TAG+="hil-bench"

# FTDI USB-serial adapters (common for target UART)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", \
    MODE="0666", \
    TAG+="hil-bench"

# Miniscope USB CDC devices (VID:PID cafe:4001)
SUBSYSTEM=="tty", ATTRS{idVendor}=="cafe", ATTRS{idProduct}=="4001", \
    MODE="0666", \
    SYMLINK+="miniscope-cdc-%n", \
    TAG+="hil-bench"

# Espressif USB Serial/JTAG controller (ESP32-C3/C6/S3 built-in, VID:PID 303a:1001).
# One CDC-ACM port is both the esptool flash port and the firmware console.
# It re-enumerates after every reset/flash, so match on tty and use by-id paths in config.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
    MODE="0666", \
    SYMLINK+="esp32-usbjtag-%n", \
    TAG+="hil-bench"

SUBSYSTEM=="usb", ATTR{idVendor}=="303a", ATTR{idProduct}=="1001", \
    MODE="0666", \
    TAG+="hil-bench"
